@@ -6737,4 +6737,61 @@
 AC_SUBST([LIBPL])
 
+# Compute installed loader paths on the build host, including for cross builds.
+pbs_relpath () (
+  test "$prefix" != NONE || prefix=$ac_default_prefix
+  test "$exec_prefix" != NONE || exec_prefix=$prefix
+  "$PYTHON_FOR_REGEN" -c '
+import os.path as p, sys
+from string import Template
+_, prefix, root, src, dst = sys.argv
+root = Template(root).safe_substitute(prefix=prefix)
+src, dst = (p.normpath(Template(path).safe_substitute(prefix=prefix, exec_prefix=root))
+            for path in (src, dst))
+if p.commonpath((root, src, dst)) == root:
+    print(p.relpath(dst, src))
+' "$prefix" "$exec_prefix" "[$]1" "[$]2"
+)
+PBS_LIB_SUBDIR=
+pbs_pc_to_prefix=$(pbs_relpath "$libdir/pkgconfig" '${prefix}') || exit 1
+PBS_PC_PREFIX=$prefix
+test "$PBS_PC_PREFIX" != NONE || PBS_PC_PREFIX=$ac_default_prefix
+AS_IF([test -n "$pbs_pc_to_prefix"], [PBS_PC_PREFIX='${pcfiledir}/'"$pbs_pc_to_prefix"])
+pbs_bindir_to_lib=$(pbs_relpath "$bindir" "$libdir") || exit 1
+pbs_ext_to_lib=$(pbs_relpath '${exec_prefix}/'"$PLATLIBDIR/python$VERSION$ABI_THREAD/lib-dynload" "$libdir") || exit 1
+PBS_LIBPYTHON_RPATH=
+PBS_EXTENSION_RPATH=
+PBS_PYTHON_RPATH=
+PBS_DYLIB_ID='$(prefix)/lib/libpython$(LDVERSION).dylib'
+PBS_EMBED_RPATH=
+AS_IF([test "$PY_ENABLE_SHARED" = 1], [
+PBS_LIB_SUBDIR=$(pbs_relpath '${exec_prefix}' "$libdir") || exit 1
+AS_CASE([$ac_sys_system],
+  [Linux], [
+    pbs_origin='$$ORIGIN'
+    pbs_rpath=-Wl,--enable-new-dtags,-rpath
+    # On musl a library opened by pathname has no short name for later lookup.
+    AS_CASE([$host], [*-musl*], [
+      AS_IF([test -n "$pbs_bindir_to_lib"], [PBS_PYTHON_RPATH="$pbs_rpath,'$pbs_origin/$pbs_bindir_to_lib'"])
+    ])
+  ],
+  [Darwin], [
+    pbs_origin=@loader_path
+    pbs_rpath=-Wl,-rpath
+    PBS_DYLIB_ID='@rpath/libpython$(LDVERSION).dylib'
+    PBS_EMBED_RPATH='-Wl,-rpath,${libdir}'
+  ])
+])
+AS_IF([test -n "$pbs_origin"], [
+  PBS_LIBPYTHON_RPATH="$pbs_rpath,'$pbs_origin'"
+  AS_IF([test -n "$pbs_ext_to_lib"], [PBS_EXTENSION_RPATH="$pbs_rpath,'$pbs_origin/$pbs_ext_to_lib'"])
+])
+AC_SUBST([PBS_LIB_SUBDIR])
+AC_SUBST([PBS_PC_PREFIX])
+AC_SUBST([PBS_LIBPYTHON_RPATH])
+AC_SUBST([PBS_EXTENSION_RPATH])
+AC_SUBST([PBS_PYTHON_RPATH])
+AC_SUBST([PBS_DYLIB_ID])
+AC_SUBST([PBS_EMBED_RPATH])
+
 # Check for --with-wheel-pkg-dir=PATH
 AC_SUBST([WHEEL_PKG_DIR])
