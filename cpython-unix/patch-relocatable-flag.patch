diff --git a/configure.ac b/configure.ac
index a8760c9..be7ad9c 100644
--- a/configure.ac
+++ b/configure.ac
@@ -1594,6 +1594,26 @@ if test "x$enable_profiling" = xyes; then
   LDFLAGS="-pg $LDFLAGS"
 fi
 
+AC_MSG_CHECKING([for --enable-relocatable])
+AC_ARG_ENABLE([relocatable],
+  AS_HELP_STRING([--enable-relocatable],
+                 [use relative runtime library paths (default is no)]),
+  [], [enable_relocatable=no])
+AS_CASE([$enable_relocatable],
+  [yes|no], [],
+  [AC_MSG_ERROR([--enable-relocatable must be yes or no])])
+AC_MSG_RESULT([$enable_relocatable])
+AS_VAR_IF([enable_relocatable], [yes], [
+  AS_CASE([$ac_sys_system],
+    [Linux|Darwin], [],
+    [AC_MSG_ERROR([--enable-relocatable is supported only on Linux and macOS])])
+  AS_VAR_IF([enable_framework], [], [],
+    [AC_MSG_ERROR([--enable-relocatable does not support framework builds])])
+  AC_DEFINE([Py_ENABLE_RELOCATABLE], [1],
+            [Define if --enable-relocatable is used.])
+])
+AC_SUBST([RELOCATABLE], [$enable_relocatable])
+
 AC_MSG_CHECKING([LDLIBRARY])
 
 # Apple framework builds need more magic. LDLIBRARY is the dynamic
diff --git a/Doc/using/configure.rst b/Doc/using/configure.rst
index 0d420d8..e033256 100644
--- a/Doc/using/configure.rst
+++ b/Doc/using/configure.rst
@@ -1073,6 +1073,28 @@ Linker options
 
    Enable building a shared Python library: ``libpython`` (default is no).
 
+.. option:: --enable-relocatable
+
+   Use relative runtime library paths for the interpreter, ``libpython``,
+   and standard-library extension modules (default is no).
+
+   This option supports Linux and non-framework macOS builds. The installation
+   must use the default ``bin`` and ``lib`` directories under a common prefix.
+   :option:`--with-platlibdir` may select a different directory name for the
+   standard library, but not a nested path.
+   Move the installation as a unit, keeping these relative locations intact.
+
+   On Linux, use ``DT_RPATH``; on glibc this gives bundled libraries precedence
+   over ``LD_LIBRARY_PATH``. On macOS, use an ``@rpath`` install name for
+   ``libpython`` and loader-relative paths for its dependencies and extension
+   modules. Applications embedding Python must ensure that the dynamic loader
+   can find ``libpython`` and that Python can find its standard library; this
+   option does not configure those paths for them.
+
+   This option does not bundle third-party libraries or relocate their data
+   files. It does not rewrite installed script shebangs or build-time paths in
+   :mod:`sysconfig`.
+
 .. option:: --without-static-libpython
 
    Do not build ``libpythonMAJOR.MINOR.a`` and do not install ``python.o``
