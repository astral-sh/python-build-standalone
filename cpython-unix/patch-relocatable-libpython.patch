Resolve a wheel's libpython dependency from a relocated static launcher on glibc.

--- a/configure.ac
+++ b/configure.ac
@@ -6802,4 +6802,11 @@
 AC_SUBST([RELOCATABLE_EXTENSION_LDFLAGS])
 AC_SUBST([LIBPYTHON_INSTALL_NAME])
+RELOCATABLE_LIBPYTHON=
+AS_IF([test "$enable_relocatable" = yes && test "$ac_sys_system" = Linux &&
+       test "$PY_ENABLE_SHARED" = 1 && test "$enable_static_libpython_for_interpreter" = yes], [
+  libdir_from_prefix=$(relative_dir '${exec_prefix}' "$libdir")
+  RELOCATABLE_LIBPYTHON="$libdir_from_prefix/"'$(INSTSONAME)'
+])
+AC_SUBST([RELOCATABLE_LIBPYTHON])
 
 # Check for --with-wheel-pkg-dir=PATH
--- a/Makefile.pre.in
+++ b/Makefile.pre.in
@@ -66,4 +66,5 @@
 RELOCATABLE_EXTENSION_LDFLAGS=@RELOCATABLE_EXTENSION_LDFLAGS@
 LIBPYTHON_INSTALL_NAME=@LIBPYTHON_INSTALL_NAME@
+RELOCATABLE_LIBPYTHON=@RELOCATABLE_LIBPYTHON@
 
 # Shell used by make (some versions default to the login shell, which is bad)
@@ -1977,7 +1978,9 @@
 		-DVPATH='"$(VPATH)"' \
 		-DPLATLIBDIR='"$(PLATLIBDIR)"' \
+		$(if $(RELOCATABLE_LIBPYTHON),-DRELOCATABLE_LIBPYTHON='L"$(RELOCATABLE_LIBPYTHON)"') \
 		-DPYTHONFRAMEWORK='"$(PYTHONFRAMEWORK)"' \
 		-o $@ $(srcdir)/Modules/getpath.c
 
+Programs/python.o: CFLAGS_NODIST += $(if $(RELOCATABLE_LIBPYTHON),-DPRELOAD_LIBPYTHON)
 Programs/python.o: $(srcdir)/Programs/python.c
 	$(CC) -c $(PY_CORE_CFLAGS) -o $@ $(srcdir)/Programs/python.c
--- a/Programs/python.c
+++ b/Programs/python.c
@@ -2,4 +2,7 @@
 
 #include "Python.h"
+#if defined(PRELOAD_LIBPYTHON) && defined(__GLIBC__)
+#  include "pycore_pathconfig.h"
+#endif
 
 #ifdef MS_WINDOWS
@@ -13,4 +16,7 @@
 main(int argc, char **argv)
 {
+#if defined(PRELOAD_LIBPYTHON) && defined(__GLIBC__)
+    _PyPathConfig_RequestLibpython();
