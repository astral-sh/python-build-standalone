--- /dev/null
+++ b/Tools/build/install-relocatable-script.py
@@ -0,0 +1,29 @@
+"""Install a Unix entry point that runs the interpreter shipped alongside it."""
+
+import os
+from pathlib import Path
+import sys
+
+
+def install_script(interpreter, source, destination):
+    data = source.read_bytes()
+    shebang, _, body = data.partition(b"\n")
+    if shebang == b"#!/bin/sh" and body.startswith(b"'''exec' "):
+        # pip uses a shell trampoline when the interpreter path is long or contains spaces.
+        command, _, rest = body.partition(b"\n")
+        end, _, script = rest.partition(b"\n")
+        if b"python" in command and end == b"' '''":
+            shebang, body = b"#!python", script
+    if shebang.startswith(b"#!") and b"python" in shebang:
+        relative = os.path.relpath(interpreter, destination.parent)
+        header = f"""#!/bin/sh
+'''exec' "$(dirname -- "$(realpath -- "$0")")/{relative}" "$0" "$@"
+' '''
+"""
+        data = os.fsencode(header) + body
+    destination.write_bytes(data)
+    destination.chmod(0o755)
+
+
+if __name__ == "__main__":
+    install_script(*map(Path, sys.argv[1:]))
