--- /dev/null
+++ b/Tools/build/write-python-script.py
@@ -0,0 +1,20 @@
+"""Write a Python entry point that locates its installed interpreter relative to itself."""
+
+import os
+import shlex
+import sys
+
+interpreter, script_dir = sys.argv[1:]
+relative = shlex.quote(os.path.relpath(interpreter, script_dir))
+header = f"""#!/bin/sh
+'''exec' "$(script=$0
+while test -L "$script"; do
+    link=$(readlink "$script") || exit 1
+    case $link in /*) script=$link ;; *) script=$(dirname "$script")/$link ;; esac
+done
+dirname "$script")"/{relative} "$0" "$@"
+' '''
+"""
+sys.stdin.buffer.readline()
+sys.stdout.buffer.write(os.fsencode(header))
+sys.stdout.buffer.write(sys.stdin.buffer.read())
