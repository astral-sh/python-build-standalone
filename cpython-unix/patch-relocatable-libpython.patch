--- a/Include/internal/pycore_pathconfig.h
+++ b/Include/internal/pycore_pathconfig.h
@@ -13,4 +13,7 @@
 
 extern PyStatus _PyPathConfig_ReadGlobal(PyConfig *config);
+#if defined(Py_ENABLE_RELOCATABLE) && defined(__GLIBC__)
+extern void _PyPathConfig_RequestLibpython(void);
+#endif
 extern PyStatus _PyPathConfig_UpdateGlobal(const PyConfig *config);
 extern const wchar_t * _PyPathConfig_GetGlobalModuleSearchPath(void);
--- a/Modules/getpath.c
+++ b/Modules/getpath.c
@@ -889,4 +889,41 @@
 }
 
+
+#if defined(RELOCATABLE_LIBPYTHON) && defined(__GLIBC__)
+static bool preload_requested;
+
+void
+_PyPathConfig_RequestLibpython(void)
+{
+    preload_requested = true;
+}
+
+static PyStatus
+preload_libpython(const PyConfig *config)
+{
+    if (!preload_requested) {
+        return _PyStatus_OK();
+    }
+    preload_requested = false;
+    if (config->_is_python_build || config->base_exec_prefix == NULL ||
+        !_Py_isabs(config->base_exec_prefix)) {
+        return _PyStatus_OK();
+    }
+    wchar_t *path = _Py_join_relfile(config->base_exec_prefix, RELOCATABLE_LIBPYTHON);
+    if (path == NULL) {
+        return PyStatus_NoMemory();
+    }
+    char *filename = Py_EncodeLocale(path, NULL);
+    PyMem_RawFree(path);
+    if (filename == NULL) {
+        return PyStatus_NoMemory();
+    }
+    // Keep this DSO mapped so a wheel requesting its soname can reuse it.
+    // The statically linked interpreter also works without the shared library.
+    (void)dlopen(filename, RTLD_LAZY | RTLD_LOCAL);
+    PyMem_Free(filename);
+    return _PyStatus_OK();
+}
+#endif
 
 /* Perform the actual path calculation.
@@ -1030,4 +1067,8 @@
     Py_DECREF(dict);
 
+#if defined(RELOCATABLE_LIBPYTHON) && defined(__GLIBC__)
+    return preload_libpython(config);
+#else
     return _PyStatus_OK();
-}
+#endif
+}
--- a/Doc/using/configure.rst
+++ b/Doc/using/configure.rst
@@ -1052,4 +1052,10 @@
    and extensions. Move these directories together.
 
+   On glibc, when :option:`--enable-static-libpython-for-interpreter` is
+   also enabled, the installed command-line interpreter opens its versioned
+   shared library before importing :mod:`site`. This allows extensions that
+   depend on its soname to find it. The interpreter can run without the
+   shared library.
