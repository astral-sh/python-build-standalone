--- a/Modules/getpath.c
+++ b/Modules/getpath.c
@@ -889,4 +889,37 @@
 }
 
+
+#ifdef __GLIBC__
+int _Py_pbs_preload_libpython;
+
+static PyStatus
+preload_libpython(const PyConfig *config)
+{
+    if (!_Py_pbs_preload_libpython) {
+        return _PyStatus_OK();
+    }
+    _Py_pbs_preload_libpython = 0;
+#ifdef PBS_LIBPYTHON
+    if (!config->_is_python_build && config->base_exec_prefix != NULL &&
+        _Py_isabs(config->base_exec_prefix)) {
+        wchar_t *path = _Py_join_relfile(config->base_exec_prefix, PBS_LIBPYTHON);
+        if (path == NULL) {
+            return PyStatus_NoMemory();
+        }
+        char *filename = Py_EncodeLocale(path, NULL);
+        PyMem_RawFree(path);
+        if (filename == NULL) {
+            return PyStatus_NoMemory();
+        }
+        /* Load this installation's libpython so extensions that need its soname
+           can find it even when their RUNPATH points elsewhere. A distribution
+           may omit the shared library. */
+        (void)dlopen(filename, RTLD_LAZY | RTLD_LOCAL);
+        PyMem_Free(filename);
+    }
+#endif
+    return _PyStatus_OK();
+}
+#endif
 
